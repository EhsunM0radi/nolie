# Application Base Configuration
NODE_ENV=development
APP_URL=REPLACE_WITH_VALUE
PORT=3000

# Supabase PostgreSQL & Auth Configuration
DATABASE_URL=REPLACE_WITH_SECRET
SUPABASE_URL=REPLACE_WITH_SECRET
SUPABASE_ANON_KEY=REPLACE_WITH_SECRET
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SECRET

# Telegram Bot & Mini App Configuration
TELEGRAM_BOT_TOKEN=REPLACE_WITH_SECRET
TELEGRAM_BOT_USERNAME=REPLACE_WITH_PUBLIC_VALUE
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=REPLACE_WITH_PUBLIC_VALUE
NEXT_PUBLIC_APP_URL=REPLACE_WITH_VALUE

# Cloudflare R2 Object Storage (Temporary verification files)
R2_ACCOUNT_ID=REPLACE_WITH_SECRET
R2_ACCESS_KEY_ID=REPLACE_WITH_SECRET
R2_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
R2_BUCKET_NAME=REPLACE_WITH_VALUE
R2_PUBLIC_URL=REPLACE_WITH_VALUE_IF_NEEDED

# External SMS Provider (OTP dispatch)
SMS_PROVIDER_TYPE=mock
SMS_PROVIDER_API_KEY=REPLACE_WITH_SECRET
SMS_PROVIDER_API_SECRET=REPLACE_WITH_SECRET
SMS_PROVIDER_SENDER_NUMBER=REPLACE_WITH_VALUE

# Iranian Phone Ownership Provider (Shahkar / Mobile-National ID verification)
PHONE_IDENTITY_PROVIDER_TYPE=mock
PHONE_IDENTITY_PROVIDER_API_KEY=REPLACE_WITH_SECRET
PHONE_IDENTITY_PROVIDER_API_SECRET=REPLACE_WITH_SECRET

# External Face & KYC Verification Provider
IDENTITY_PROVIDER_TYPE=mock
IDENTITY_PROVIDER_API_KEY=REPLACE_WITH_SECRET
IDENTITY_PROVIDER_API_SECRET=REPLACE_WITH_SECRET
IDENTITY_PROVIDER_BASE_URL=https://api.example-kyc.com

# Webhook & Cron Security Secrets
WEBHOOK_SECRET=REPLACE_WITH_SECRET
CRON_SECRET=REPLACE_WITH_SECRET

# Firebase Cloud Messaging (FCM Breakup & Invite Push Notifications)
FCM_PROJECT_ID=REPLACE_WITH_SECRET
FCM_CLIENT_EMAIL=REPLACE_WITH_SECRET
FCM_PRIVATE_KEY=REPLACE_WITH_SECRET

# Google Analytics (GA4) Configuration
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin Security Key
ADMIN_API_KEY=REPLACE_WITH_SECRET
